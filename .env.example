# ─── Database ───
# SQLite (development)
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://hlmedia:password@localhost:5432/hlmedia"

# ─── Auth ───
AUTH_SECRET="generate-a-random-32-char-string"
AUTH_TRUST_HOST=true

# ─── Firebase Google sign-in ───
# "Continue with Google" uses Firebase Authentication (client popup → ID token,
# verified server-side against Firebase's public JWKS — no service-account key
# needed). Public web config is safe to expose to the browser. Leave blank to
# hide the Google button. Enable Google in the Firebase console:
#   Authentication → Sign-in method → Google.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# Server-side ID-token verification (issuer/audience check). Same as project id.
FIREBASE_PROJECT_ID=""

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DUE_SOON_DAYS=3

# ─── File Storage ───
# Local (development)
STORAGE_DIR="./uploads"
# S3 (production) — set S3_BUCKET to enable
# S3_BUCKET=""
# S3_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ─── Email (SMTP) ───
# Leave SMTP_HOST empty to disable email (logs to console instead)
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
SMTP_FROM="HL Media <no-reply@hlmedia.local>"

# ─── AWS SES (alternative to SMTP) ───
# If using SES, set SMTP_HOST to your SES endpoint:
# SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
# SMTP_PORT=587
# SMTP_USER=<SES SMTP username>
# SMTP_PASS=<SES SMTP password>
