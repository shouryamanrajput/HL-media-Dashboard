generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?   // optional — Google-only users & approved-but-not-yet-set-up users have no password
  title         String?   // job title, e.g. "Senior Editor"
  department    String?   // team, e.g. "Post-production"
  skills        String?   // comma-separated: "Editing,Color,Motion graphics"
  capacityHours Int?      // weekly hours available for task work
  role          String    @default("EDITOR") // ADMIN | EDITOR | REVIEWER
  roles         String    @default("") // comma-separated: "ADMIN,REVIEWER"
  scopeEntity   String?
  scopeDept     String?
  active        Boolean   @default(true)
  mustSetup     Boolean   @default(false) // true after approval → forces first-login profile+password setup
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]    @relation("UserCreatedBy")
  reviewedRequests UserRequest[] @relation("RequestReviewer")
  editedProjects   Project[] @relation("editor")
  reviewedProjects Project[] @relation("reviewer")
  createdProjects  Project[] @relation("creator")
  assignedTasks    Task[]    @relation("taskAssignee")
  createdTasks     Task[]    @relation("taskCreator")
  assets        ProjectAsset[]
  comments      Comment[]
  auditLogs     AuditLog[]
  passwordResetRequests    PasswordResetRequest[] @relation("passwordResetRequests")
  passwordResetResolutions PasswordResetRequest[] @relation("passwordResetResolutions")
}

model PasswordResetRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("passwordResetRequests", fields: [userId], references: [id], onDelete: Cascade)
  status       String    @default("PENDING") // PENDING | RESOLVED | DISMISSED
  requestedAt  DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("passwordResetResolutions", fields: [resolvedById], references: [id])

  @@index([userId])
  @@index([status])
}

model Client {
  id          String    @id @default(cuid())
  name        String    @unique
  contactName String?
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime  @default(now())
  projects    Project[]
}

model ProjectType {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id                   String    @id @default(cuid())
  projectNo            Int       @unique
  title                String
  brief                String?
  clientId             String?
  projectTypeId        String?
  source               String?   // Referral | Website | Instagram | Repeat client | Other
  priority             String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  stage                String    @default("BRIEF")  // see STAGE_LIST in lib/utils.ts
  editorId             String?
  reviewerId           String?

  receivedDate         DateTime  @default(now())
  startDate            DateTime?
  dueDate              DateTime?
  deliveredAt          DateTime?

  // Internal review
  submittedForReviewAt DateTime?
  reviewedAt           DateTime?
  reviewStatus         String?   // CHANGES_REQUESTED | APPROVED
  reviewComments       String?
  revisionCount        Int       @default(0)

  // Delivery
  finalLink            String?
  deliveryNotes        String?

  // Computed by lib/deadlines.ts
  daysOpen             Int?
  turnaroundDays       Int?
  isOverdue            Boolean   @default(false)
  overdueReason        String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String

  client               Client?      @relation(fields: [clientId], references: [id])
  projectType          ProjectType? @relation(fields: [projectTypeId], references: [id])
  editor               User?        @relation("editor", fields: [editorId], references: [id])
  reviewer             User?        @relation("reviewer", fields: [reviewerId], references: [id])
  creator              User         @relation("creator", fields: [createdById], references: [id])
  tasks                Task[]
  deliverables         Deliverable[]
  assets               ProjectAsset[]
  comments             Comment[]
  auditLogs            AuditLog[]

  @@index([editorId])
  @@index([stage])
  @@index([priority])
  @@index([clientId])
  @@index([isOverdue])
}

model Task {
  id            String    @id @default(cuid())
  projectId     String
  title         String
  description   String?
  assigneeId    String?
  status        String    @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  dueDate       DateTime?
  estimateHours Float?
  loggedHours   Float     @default(0)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?     @relation("taskAssignee", fields: [assigneeId], references: [id])
  creator       User      @relation("taskCreator", fields: [createdById], references: [id])
  comments      Comment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  platform    String?  // YouTube | Instagram | ...
  aspectRatio String?  // 16:9 | 9:16 | 1:1 | 4:5
  durationSec Int?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | READY | DELIVERED
  link        String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectAsset {
  id           String   @id @default(cuid())
  projectId    String
  kind         String   // RAW | DRAFT | FINAL | REFERENCE | OTHER
  label        String
  version      Int?
  url          String?  // external link (Frame.io / Drive / Dropbox / YouTube)
  filename     String?  // uploaded file
  storageKey   String?
  mimeType     String?
  size         Int?
  uploadedById String
  uploadedAt   DateTime @default(now())

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([projectId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  taskId    String?
  userId    String
  body      String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([projectId])
}

model AuditLog {
  id        String   @id @default(cuid())
  projectId String?
  entity    String
  entityId  String
  action    String   // CREATE | UPDATE | DELETE | STAGE_CHANGE | FILE_UPLOAD | ASSIGN | REVIEW | USER_* | LOGIN_*
  diff      String   // JSON
  userId    String
  ip        String?  // request IP for admin/auth events (when available)
  at        DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([entity, entityId])
}

model AppSetting {
  key   String @id
  value String
}

// Admin-controlled onboarding: a pending access request awaiting review.
// Created when someone signs in with Google but has no account yet.
model UserRequest {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique   // one open request per email; blocks duplicates
  firebaseUid  String?             // set when the request came via Google
  loginMethod  String              // "PASSWORD" | "GOOGLE"
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  note         String?             // optional reviewer note / rejection reason
  requestedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("RequestReviewer", fields: [reviewedById], references: [id])

  @@index([status])
}
